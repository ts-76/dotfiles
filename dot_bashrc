# =============================================================================
# Bash エントリーポイント (~/.bashrc)
# =============================================================================

# 非対話シェルでは何もしない
case $- in
  *i*) ;;
  *) return ;;
esac

# Bash を普段使わない場合は Zsh に委譲
if command -v zsh > /dev/null 2>&1 && [ -z "${ZSH_VERSION:-}" ]; then
  exec zsh
fi
