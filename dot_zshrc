# =============================================================================
# Zsh エントリーポイント (~/.zshrc)
# =============================================================================

# 非対話シェルでは何もしない
[[ -o interactive ]] || return

# =============================================================================
# Nix設定 (Devbox依存)
# =============================================================================
if [ -e '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh' ]; then
  source '/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh'
fi

# =============================================================================
# 環境変数 (exports)
# =============================================================================
if [ -d "$HOME/.config/zsh" ]; then
  [ -f "$HOME/.config/zsh/exports.zsh" ] && source "$HOME/.config/zsh/exports.zsh"
fi

# =============================================================================
# Devboxの有効化 (Global)
# =============================================================================
if command -v devbox > /dev/null 2>&1; then
  eval "$(devbox global shellenv)"
fi

if [ -n "${NPM_CONFIG_PREFIX:-}" ]; then
  PATH="${PATH//:$NPM_CONFIG_PREFIX\/bin/}"
  PATH="${PATH//#$NPM_CONFIG_PREFIX\/bin:/}"
  PATH="$NPM_CONFIG_PREFIX/bin:$PATH"
  export PATH
fi

# =============================================================================
# 補完設定
# =============================================================================
autoload -Uz compinit
_zcompdump_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$_zcompdump_dir"
compinit -d "$_zcompdump_dir/.zcompdump"
unset _zcompdump_dir

# =============================================================================
# エイリアス/関数
# =============================================================================
if [ -d "$HOME/.config/zsh" ]; then
  [ -f "$HOME/.config/zsh/profile.local.zsh" ] && source "$HOME/.config/zsh/profile.local.zsh"
  [ -f "$HOME/.config/zsh/aliases.zsh" ] && source "$HOME/.config/zsh/aliases.zsh"
  [ -f "$HOME/.config/zsh/functions.zsh" ] && source "$HOME/.config/zsh/functions.zsh"
  [ -f "$HOME/.config/zsh/git-account-switch.zsh" ] && source "$HOME/.config/zsh/git-account-switch.zsh"
  [ -f "$HOME/.config/zsh/git-account-auto.zsh" ] && source "$HOME/.config/zsh/git-account-auto.zsh"
  [ -f "$HOME/.config/zsh/credentials.zsh" ] && source "$HOME/.config/zsh/credentials.zsh"
  [ -f "$HOME/.config/zsh/gh-onboard.zsh" ] && source "$HOME/.config/zsh/gh-onboard.zsh"
fi

if command -v direnv > /dev/null 2>&1; then
  eval "$(direnv hook zsh)"
fi

# Powerlevel10k
if [ -r /usr/share/zsh-powerlevel10k/powerlevel10k.zsh-theme ]; then
  source /usr/share/zsh-powerlevel10k/powerlevel10k.zsh-theme
elif [ -r "$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default/share/zsh-powerlevel10k/powerlevel10k.zsh-theme" ]; then
  source "$HOME/.local/share/devbox/global/default/.devbox/nix/profile/default/share/zsh-powerlevel10k/powerlevel10k.zsh-theme"
elif [ -r "$HOME/.nix-profile/share/zsh-powerlevel10k/powerlevel10k.zsh-theme" ]; then
  source "$HOME/.nix-profile/share/zsh-powerlevel10k/powerlevel10k.zsh-theme"
fi

[ -f "$HOME/.p10k.zsh" ] && source "$HOME/.p10k.zsh"

# zoxide must be at the end
if command -v zoxide > /dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi
