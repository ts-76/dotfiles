# =============================================================================
# Ghostty Configuration
# https://ghostty.org/docs/config
# =============================================================================

# =============================================================================
# テーマ & 外観
# =============================================================================

# TokyoNight テーマ
theme = TokyoNight

# 背景透過 (85% = 0.85)
background-opacity = 0.85

# 背景ブラー効果 (Windowsでサポートされている場合)
background-blur-radius = 20

# ウィンドウの装飾
window-decoration = true

# ウィンドウのパディング
window-padding-x = 8
window-padding-y = 8

# ウィンドウの初期サイズ (セル単位: 行数 x 列数)
window-height = 50
window-width = 150

# ウィンドウリサイズをセル単位で行う
window-step-resize = true

# =============================================================================
# フォント設定
# =============================================================================

# フォントファミリー（日本語対応のためフォールバック追加）
font-family = "JetBrains Mono"
font-family = "BIZ UDGothic Bold"
font-feature = -dlig

# フォントサイズ
font-size = 13

# フォントの太さ調整
font-thicken = true

# =============================================================================
# カーソル設定
# =============================================================================

# カーソルスタイル (block, bar, underline)
cursor-style = block

# カーソルの点滅
cursor-style-blink = true

# =============================================================================
# スクロール & パフォーマンス
# =============================================================================

# スクロールバックバッファ (行数)
scrollback-limit = 10000

# マウスでのスクロール速度
mouse-scroll-multiplier = 3

# =============================================================================
# キーバインド & マウス
# =============================================================================

# クリップボード統合
copy-on-select = true

# マウスでのテキスト選択を有効化
mouse-hide-while-typing = true

# =============================================================================
# タブ & ウィンドウ管理
# =============================================================================

# タブバーの表示 (常に表示)
window-theme = auto

# 新しいタブを現在のディレクトリで開く
window-inherit-working-directory = true

# =============================================================================
# その他の便利な設定
# =============================================================================

# ウィンドウタイトルの自動更新
window-title-font-family = "JetBrains Mono"

# クリップボードの読み取り許可
clipboard-read = allow

# クリップボードの書き込み許可
clipboard-write = allow

# 自動アップデート確認
auto-update = check
