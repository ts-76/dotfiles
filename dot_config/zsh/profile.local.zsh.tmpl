#!/usr/bin/env zsh

# Per-machine settings.
# Generated by chezmoi.

{{ $profile := (get . "dot_profile" | default "auto") -}}
export DOT_PROFILE="{{ $profile }}"

{{ $credBackend := (get . "dot_cred_backend" | default "auto") -}}
export DOT_CRED_BACKEND="{{ $credBackend }}"

{{ $sshSource := (get . "dot_github_ssh_source" | default "auto") -}}
export DOT_GITHUB_SSH_SOURCE="{{ $sshSource }}"

{{/*
  1Password SSH key references.

  Preferred: vault-id + item-id to avoid coupling to names.
  The constructed ref uses the OpenSSH format to ensure OpenSSH can parse it.
*/}}

{{ $opMainVaultID := (get . "dot_op_github_main_ssh_vault_id" | default "") -}}
{{ $opMainItemID := (get . "dot_op_github_main_ssh_item_id" | default "") -}}
{{ if and $opMainVaultID $opMainItemID -}}
export DOT_OP_GITHUB_MAIN_SSH_PRIVATE_KEY_REF="op://{{ $opMainVaultID }}/{{ $opMainItemID }}/private key?ssh-format=openssh"
{{ end -}}

{{ $opSubVaultID := (get . "dot_op_github_sub_ssh_vault_id" | default "") -}}
{{ $opSubItemID := (get . "dot_op_github_sub_ssh_item_id" | default "") -}}
{{ if and $opSubVaultID $opSubItemID -}}
export DOT_OP_GITHUB_SUB_SSH_PRIVATE_KEY_REF="op://{{ $opSubVaultID }}/{{ $opSubItemID }}/private key?ssh-format=openssh"
{{ end -}}
