{{- $flakeHash := output "nix" "hash" "path" (printf "%s/dot_local/share/devbox/global/default/nix" .chezmoi.sourceDir) | trim | urlquery -}}
{{- $packages := dict -}}
{{- range .toolCategories -}}
  {{- range $name, $version := index . "devbox" -}}
    {{- if hasKey $packages $name -}}
      {{- fail (printf "Duplicate Devbox package: %s" $name) -}}
    {{- end -}}
    {{- $_ := set $packages $name $version -}}
  {{- end -}}
  {{- range $name, $platforms := index . "devboxLocal" -}}
    {{- $ref := printf "path:%s/.local/share/devbox/global/default/nix?narHash=%s#%s" $.chezmoi.homeDir $flakeHash $name -}}
    {{- if hasKey $packages $ref -}}
      {{- fail (printf "Duplicate local Devbox package: %s" $name) -}}
    {{- end -}}
    {{- $_ := set $packages $ref (dict "version" "" "platforms" $platforms) -}}
  {{- end -}}
{{- end -}}
{{ dict "packages" $packages "shell" (dict) | mustToPrettyJson }}
