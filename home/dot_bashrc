# =============================================================================
# Bash エントリーポイント (~/.bashrc)
# =============================================================================

export T3CODE_TELEMETRY_ENABLED=false
export T3CODE_OTEL_SDK_DISABLED=true
export T3CODE_NO_BROWSER=true

# 非対話シェルではここで終了
case $- in
  *i*) ;;
  *) return ;;
esac

# Bash を普段使わない場合は Zsh に委譲
if command -v zsh > /dev/null 2>&1 && [ -z "${ZSH_VERSION:-}" ]; then
  exec zsh
fi

if [ -n "${NPM_CONFIG_PREFIX:-}" ]; then
  PATH=":$PATH:"
  PATH="${PATH//:$NPM_CONFIG_PREFIX\/bin:/:}"
  PATH="${PATH#:}"
  PATH="${PATH%:}"
  PATH="$NPM_CONFIG_PREFIX/bin:$PATH"
  export PATH
fi
